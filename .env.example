# Copy this file to .env for local development.
# Do not commit real .env files or production secrets.

FLASK_APP=runserver.py
FLASK_ENV=development

# Generate a new value for every deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LABHUB_SECRET_KEY=change-me

# Default local SQLite database. For production, point this at managed storage
# or a backed-up SQLite path outside the repository.
LABHUB_DATABASE_URI=sqlite:///site.db

# Optional: override the app log file path.
LABHUB_LOG_FILE=logs/error.log

# Set to true only when you want the public demo account and sample records.
LABHUB_SEED_DEMO_DATA=false

# Set to true only for an intentionally public demo instance.
LABHUB_AUTO_LOGIN_DEMO=false

# Set to true when served over HTTPS (marks session cookies Secure).
LABHUB_SECURE_COOKIES=false

# Maximum request body size in MB (pasted images are sent as base64).
LABHUB_MAX_UPLOAD_MB=32

# Log level: DEBUG, INFO, WARNING, ERROR.
LABHUB_LOG_LEVEL=INFO

# Only for local development; never enable the debugger on a reachable host.
LABHUB_DEBUG=false
