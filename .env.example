# Copy this file to .env for local development.
# Do not commit real .env files or production secrets.

FLASK_APP=runserver.py
FLASK_ENV=development

# Generate a new value for every deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LABHUB_SECRET_KEY=change-me

# Default local SQLite database. For production, point this at managed storage
# or a backed-up SQLite path outside the repository.
LABHUB_DATABASE_URI=sqlite:///site.db

# Optional: override the app log file path.
LABHUB_LOG_FILE=logs/error.log
